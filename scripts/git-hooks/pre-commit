#!/bin/sh
# Integration changes arrive through reviewed PR merges.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
if [ "$branch" = main ] && ! git rev-parse --verify --quiet MERGE_HEAD >/dev/null; then
    printf '%s\n' 'Direct commits to main are disabled. Commit on codex/development and open a PR.' >&2
    exit 1
fi
